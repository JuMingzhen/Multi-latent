{
  "model": {
    "name_or_path": "gpt2",
    "trust_remote_code": false
  },
  "data": {
    "train_file": "data/easy_test.jsonl",
    "val_file": null,
    "max_samples": null,
    "max_seq_length": 512,
    "dataset_type": "answer_only",
    "cot_prefix": ""
  },
  "training": {
    "method": "sft",
    "output_dir": "train/checkpoints",
    "num_train_epochs": 3,
    "per_device_train_batch_size": 4,
    "per_device_eval_batch_size": 4,
    "gradient_accumulation_steps": 1,
    "learning_rate": 5e-5,
    "weight_decay": 0.01,
    "warmup_steps": 100,
    "warmup_ratio": null,
    "lr_scheduler_type": "cosine",
    "logging_steps": 10,
    "save_steps": 500,
    "eval_steps": null,
    "save_total_limit": 3,
    "seed": 42,
    "fp16": true,
    "bf16": false,
    "gradient_checkpointing": false,
    "dataloader_num_workers": 4,
    "remove_unused_columns": false,
    "report_to": "wandb",
    "run_name": "my-gpt2-run",
    "project": "llm-training"
  },
  "distributed": {
    "use_ddp": true,
    "backend": "nccl",
    "find_unused_parameters": false
  },
  "prompt_template": {
    "system_prompt": "You are a logical reasoning assistant. Answer the question based on the given facts.",
    "input_template": "{context}",
    "output_template": "{answer}",
    "instruction_template": "{system_prompt}\n\n{input}\n\nAnswer:"
  }
}

