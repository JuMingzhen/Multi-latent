{
  "model": {
    "name_or_path": "../models/GPT2",
    "trust_remote_code": true
  },
  "data": {
    "train_file": "data/easy_train.jsonl",
    "val_file": "data/easy_val.jsonl",
    "max_samples": null,
    "max_seq_length": 1536,
    "dataset_type": "answer_only",
    "cot_prefix": ""
  },
  "training": {
    "method": "sft",
    "output_dir": "../checkpoints",
    "num_train_epochs": 20,
    "per_device_train_batch_size": 32,
    "per_device_eval_batch_size": 32,
    "gradient_accumulation_steps": 1,
    "learning_rate": 5e-5,
    "weight_decay": 0.01,
    "warmup_steps": 500,
    "warmup_ratio": null,
    "lr_scheduler_type": "cosine",
    "logging_steps": 100,
    "save_steps": 500,
    "eval_steps": 500,
    "save_total_limit": null,
    "save_strategy": "epoch",
    "evaluation_strategy": "epoch",
    "seed": 42,
    "fp16": false,
    "bf16": false,
    "gradient_checkpointing": true,
    "dataloader_num_workers": 4,
    "remove_unused_columns": false,
    "report_to": "wandb",
    "run_name": "gpt2-easy-onlyanswer-20",
    "project": "multi-latent"
  },
  "distributed": {
    "use_ddp": true,
    "backend": "nccl",
    "find_unused_parameters": false
  },
  "prompt_template": {
    "system_prompt": null,
    "input_template": "{context}",
    "output_template": "{answer}",
    "instruction_template": "{system_prompt}\n\n{input}\n\nAnswer:"
  }
}